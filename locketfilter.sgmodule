#!name=@thats_novaa - Locket Filter (Fixed by Bảo Minh)
#!desc=Locket Gold Filter AI - Full UI 3D, Photobooth, Fix Viewers & Upload
#!distributor=Novaa
#!author=Novaa & BaoMinh
#!system=ios

[Rule]
# Chặn QUIC/UDP cho Locket (Ép đi qua TCP để Shadowrocket tiêm thuốc)
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.revenuecat.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,locketcamera.com),(PROTOCOL,UDP)),REJECT

# Chặn Sentry (Chặn gửi báo cáo lỗi về Locket)
DOMAIN-SUFFIX,sentry.io,REJECT
DOMAIN-SUFFIX,ingest.sentry.io,REJECT

[Header Rewrite]
# Xóa Cache / ETag trên RevenueCat
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del x-revenuecat-etag
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del X-RevenueCat-ETag
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del if-none-match
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del If-None-Match
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del if-modified-since
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del If-Modified-Since

# Xóa Cache / ETag trên Firebase Remote Config
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del if-none-match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del If-None-Match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del if-modified-since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del If-Modified-Since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del x-goog-if-none-match

[Script]
# 1. Xóa Header ETag/Cache bằng Script cho RevenueCat & Firebase
deleteHeader_RC = type=http-request,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(receipts$|subscribers\/[^/]+$),script-path=https://raw.githubusercontent.com/bminhfco/sdrk/refs/heads/main/deleteHeader_RC.js,timeout=60
deleteHeader_Firebase = type=http-request,pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+,script-path=https://raw.githubusercontent.com/bminhfco/sdrk/refs/heads/main/deleteHeader_Firebase.js,timeout=60

# 2. Mở khóa Locket Gold trên RevenueCat
locket_gold_rc = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(receipts$|subscribers\/[^/]+$),requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/bminhfco/sdrk/refs/heads/main/evenuecat.js,timeout=60

# 3. Nạp UI Filters 3D, Photobooth, Widget & Captions trên Firebase
locket_rc = type=http-response,pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+,requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/bminhfco/sdrk/refs/heads/main/locketfix.js,timeout=60

# 4. Xử lý chụp AI Filter & Photobooth 4 ô (Chỉ bắt đúng /generateFilteredImage)
locket_pb_req = type=http-request,pattern=^https?:\/\/api\.locketcamera\.com\/generateFilteredImage.*,requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/bminhfco/sdrk/refs/heads/main/locket_pb_req.js,timeout=60

# 5. Đổi Huy hiệu vàng Profile (Chỉ bắt đúng /changeProfileInfo)
locket_change_profile = type=http-request,pattern=^https?:\/\/api\.locketcamera\.com\/changeProfileInfo.*,script-path=https://raw.githubusercontent.com/bminhfco/sdrk/refs/heads/main/locket_change_profile.js,timeout=60

# 6. Cấp huy hiệu Gold VIP (Né hoàn toàn getMomentViews, getLatestMomentV2 và Upload)
locket_filter_resp = type=http-response,pattern=^https?:\/\/api\.locketcamera\.com\/(changeProfileInfo|getUsers|getFriends|fetchFriends).*,requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/bminhfco/sdrk/refs/heads/main/locket_filter_resp.js,timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com
